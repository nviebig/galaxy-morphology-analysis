 1) 2999.9419 1547.7452 1 1  #  Position x, y
 3) 12.1094     1          #  Integrated magnitude 
 4) 0.0094      1          #  R_e (effective radius)   [pix]
 5) 0.6853      1          #  Sersic index n (de Vaucouleurs n=4) 
 6) 0.0000      0          #     ----- 
 7) 0.0000      0          #     ----- 
 8) 0.0000      0          #     ----- 
 9) 0.0463      1          #  Axis ratio (b/a)  
10) -21.5917    1          #  Position angle (PA) [deg: Up=0, Left=90]
 Z) 0                      #  Skip this model in output image?  (yes=1, no=0)

# Component number: 2
 0) sky                    #  Component type
